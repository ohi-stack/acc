{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "platform": "ACC",
  "version": "1.3.0",
  "canonicalDomain": "acc.onegodian.com",
  "moduleContract": ["intake", "validate", "execute", "verify", "log", "output"],
  "authorityModel": {
    "humanFinalAuthority": true,
    "rule": "Oru’Valen and OMOS provide intelligence and decision support; ACC coordinates governed execution; privileged actions require applicable policy and human authorization."
  },
  "modules": [
    {
      "id": "ohi-command-console",
      "label": "OHI Command Console",
      "type": "console",
      "routes": ["/ohi", "/ohi/services", "/ohi/executions", "/ohi/policies", "/ohi/audit", "/ohi/registry"],
      "services": ["oscc", "ocp", "oeg", "identity", "registry", "audit"],
      "authority": "governed-api-only"
    },
    {
      "id": "agent-command-console",
      "label": "Agent Command Console",
      "type": "console",
      "routes": ["/agents", "/tasks", "/workflows", "/queues", "/schedules", "/logs"],
      "services": ["agent-registry", "task-queue", "workflow-engine", "runner"],
      "authority": "governed-api-only"
    },
    {
      "id": "oruvalen-intelligence-twin-console",
      "label": "Oru’Valen™",
      "type": "intelligence-console",
      "routes": ["/oruvalen", "/oruvalen/context", "/oruvalen/memory", "/oruvalen/decisions", "/oruvalen/provenance"],
      "services": ["onegodian-llm", "institutional-memory", "lived-experience", "decision-memory", "current-state-model", "provenance"],
      "authority": "decision-support-only"
    },
    {
      "id": "omos-console",
      "label": "OMOS™",
      "type": "operating-system-console",
      "routes": ["/omos", "/omos/reference-run", "/omos/providers", "/omos/persistence", "/omos/manifest"],
      "services": ["omos-runtime", "alignment", "engineering-council", "provider-routing", "decision-records"],
      "authority": "governed-api-only"
    },
    {
      "id": "runtime-console",
      "label": "Runtime Console",
      "type": "console",
      "routes": ["/runtime", "/runtime/health", "/runtime/executions", "/runtime/topology"],
      "services": ["oeg", "runner", "adapters", "telemetry"],
      "authority": "read-and-approved-control"
    },
    {
      "id": "governance-console",
      "label": "Governance Console",
      "type": "console",
      "routes": ["/governance", "/governance/policies", "/governance/approvals", "/governance/overrides"],
      "services": ["oscc", "ocp"],
      "authority": "human-authorization-required"
    },
    {
      "id": "registry-console",
      "label": "Registry Console",
      "type": "console",
      "routes": ["/registry", "/registry/odin", "/registry/obp1", "/registry/certificates"],
      "services": ["registry", "validator", "allocator", "certificate-engine"],
      "authority": "policy-constrained"
    },
    {
      "id": "identity-console",
      "label": "Identity Console",
      "type": "console",
      "routes": ["/identity", "/identity/users", "/identity/roles", "/identity/api-keys", "/identity/sessions"],
      "services": ["auth", "oidc", "rbac"],
      "authority": "restricted-admin"
    },
    {
      "id": "audit-console",
      "label": "Audit Console",
      "type": "console",
      "routes": ["/audit", "/audit/executions", "/audit/security", "/audit/changes"],
      "services": ["logs", "ledger"],
      "authority": "append-only-read"
    },
    {
      "id": "integrations-console",
      "label": "Integrations Console",
      "type": "console",
      "routes": ["/integrations", "/integrations/wordpress", "/integrations/github", "/integrations/google", "/integrations/stripe", "/integrations/omos", "/integrations/onegodian-llm"],
      "services": ["adapters", "wp-adapter", "omos-adapter", "llm-adapter"],
      "authority": "adapter-mediated"
    }
  ]
}
