{
  "name": "@onegodian/acc",
  "version": "1.3.0",
  "description": "ACC — unified OHI Command Console and Agent Command Console for governed systems, Oru’Valen intelligence-twin support, OMOS integration, agents, workflows, runtime, identity, registry, audit, and integrations.",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:client": "esbuild src/client/index.tsx --bundle --outfile=public/bundle.js --format=esm --jsx=automatic --minify",
    "build:schema": "node scripts/copy-schema.mjs",
    "build": "npm run build:client && tsc && npm run build:schema",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "preflight:production": "node scripts/preflight-production.mjs",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "test:auth": "node scripts/auth-contract.mjs",
    "test": "npm run check && npm run build && npm run test:smoke && npm run test:auth"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.21.0",
    "@types/pg": "^8.23.1",
    "bullmq": "^5.12.12",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.41.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "uuid": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "onegodian": {
    "canonicalDomain": "acc.onegodian.com",
    "platform": "ACC",
    "version": "1.3.0",
    "consoles": [
      "ohi-command-console",
      "agent-command-console",
      "oruvalen-intelligence-twin-console",
      "omos-console"
    ],
    "humanFinalAuthority": true
  }
}
