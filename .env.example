NODE_ENV=development
APP_NAME=acc
ACC_VERSION=1.3.0
PORT=3000
LOG_LEVEL=info

# Production must use a non-local PostgreSQL URL. Local/test may use the default PGlite fallback.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/acc
DATABASE_SSL=false
ACC_DB_POOL_MAX=10
ACC_DB_CONNECT_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
QUEUE_NAME=acc-tasks

# Production must be an explicit trusted origin, never *.
ALLOW_CORS_ORIGIN=*

# Production operational API authentication. Never commit the real value.
API_KEY=

# Production actor/authority is server-bound after API authentication; caller role headers are overwritten.
ACC_OPERATOR_ID=local-operator
ACC_OPERATOR_ROLE=acc_operator

# Demo/baseline seed data is for development/test only.
ACC_SEED_BASELINE=false
