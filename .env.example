NODE_ENV=development
APP_NAME=acc
ACC_VERSION=1.2.0
PORT=3000
LOG_LEVEL=info

# Production must use a non-local PostgreSQL URL. Local/test may use the default PGlite fallback.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/acc
DATABASE_SSL=false
ACC_DB_POOL_MAX=10
ACC_DB_CONNECT_TIMEOUT_MS=10000

REDIS_URL=redis://localhost:6379
QUEUE_NAME=acc-tasks

# Production must be an explicit trusted origin, never *.
ALLOW_CORS_ORIGIN=*

# Production requires a strong server-side API key. Never commit the real value.
API_KEY=

# Demo/baseline seed data is for development/test only.
ACC_SEED_BASELINE=false
