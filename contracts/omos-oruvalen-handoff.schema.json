{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acc.onegodian.com/schemas/omos-oruvalen-handoff.schema.json",
  "title": "OMOS OruValen ACC Authorized Execution Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionRecordId", "humanApproval", "action", "requestedCapability", "requestedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionRecordId": { "type": "string", "minLength": 1 },
    "oruContextSnapshotHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedBy", "approvedAt"],
      "properties": {
        "status": { "const": "approved" },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" }
      }
    },
    "requestedCapability": { "type": "string", "minLength": 1 },
    "epistemicBasis": {
      "type": "array",
      "items": { "enum": ["fact", "stated_position", "inference", "prediction"] },
      "uniqueItems": true
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": ["string", "null"] }
  }
}
