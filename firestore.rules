rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'onegodianone@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && isValidId(data.uid) &&
             data.email is string && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             data.role in ['super_admin', 'acc_operator', 'auditor', 'viewer'] &&
             (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().uid == request.auth.uid &&
                       incoming().role != 'super_admin' &&
                       isValidUserProfile(incoming());
      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       (
                         (isOwner(userId) &&
                          incoming().uid == existing().uid &&
                          incoming().role == existing().role &&
                          incoming().email == existing().email &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
                         isAdmin()
                       );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }

    // Audit Records Collection
    function isValidAuditRecord(data) {
      return data.keys().hasAll(['id', 'actorId', 'action', 'riskLevel', 'decision']) &&
             data.keys().hasOnly(['id', 'actorId', 'action', 'authorityScope', 'riskLevel', 'decision', 'approvalStatus', 'timestamp']) &&
             data.id is string && isValidId(data.id) &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.action is string && data.action.size() <= 128 &&
             (!('authorityScope' in data) || (data.authorityScope is string && data.authorityScope.size() <= 128)) &&
             data.riskLevel in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.decision in ['ALLOW', 'DENY', 'REQUIRE_HUMAN_APPROVAL'] &&
             (!('approvalStatus' in data) || data.approvalStatus in ['APPROVED', 'REJECTED', 'PENDING', 'SYSTEM_EXECUTED']) &&
             (!('timestamp' in data) || data.timestamp is timestamp || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    match /audit_records/{recordId} {
      allow get: if isValidId(recordId) && (isAdmin() || (isSignedIn() && existing().actorId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.actorId == request.auth.uid);
      allow create: if isValidId(recordId) &&
                       isSignedIn() &&
                       isValidAuditRecord(incoming()) &&
                       incoming().actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // SDK Connection test collection
    match /test/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow write: if isValidId(docId) && isAdmin();
    }
  }
}
